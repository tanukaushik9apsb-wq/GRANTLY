# GRANTLY Environment Configuration Template
# Copy this file to .env or .env.local to configure Supabase integration.
# Note: GRANTLY operates in a full-featured, zero-dependency offline mode if these variables are empty.

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# Optional: Application Base URL
VITE_APP_URL=http://localhost:3000
